generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TagType {
  cuisine
  trait
}

enum UserRole {
  MEMBER
  STAFF
  ADMIN
}

model Restaurant {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  image        String
  cuisine      String
  rating       Float
  deliveryTime String
  deliveryFee  String
  promo        String?

  /** Home kitchen (MEHKO) participating on the platform — used for member radius search. */
  isMehko   Boolean @default(true)
  latitude  Float?
  longitude Float?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  favorites Favorite[]
  tags      RestaurantTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isMehko])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  restaurants Restaurant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   Int     @id @default(autoincrement())
  name String
  slug String  @unique
  type TagType

  restaurants RestaurantTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantTag {
  restaurantId Int
  tagId        Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([restaurantId, tagId])
  @@index([tagId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(MEMBER)

  deliveryLine1      String?
  deliveryLine2      String?
  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?
  deliveryLat        Float?
  deliveryLng        Float?
  /** Default search radius for nearby MEHKO kitchens (miles). */
  kitchenSearchRadiusMiles Float @default(10)

  orders    Order[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id           Int        @id @default(autoincrement())
  userId       String
  restaurantId Int
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
